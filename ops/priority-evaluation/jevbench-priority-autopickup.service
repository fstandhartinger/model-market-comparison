[Unit]
Description=Pick up new paid Benchmark Heaven fast-lane orders and run their SLA sweep
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=AGENT_BOARD_NAME=fastlane-autopickup
Environment=GH_NO_UPDATE_NOTIFIER=1
ExecStart=/usr/bin/python3 %h/bin/jevbench-autopickup.py cycle
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/fastlane-autopickup %h/jobs/fastlane-evaluations
ReadWritePaths=%h/wt %h/.local/state/bh
ReadWritePaths=%h/.agent-board %h/.notify %h/.claude/skills/email-access
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
