[Unit]
Description=Pick up paid Benchmark Heaven evaluations and enforce payment-time SLAs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/bin/jevbench-priority-worker.py cycle
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.notify %h/jobs/fastlane-evaluations %h/.local/share/agent-board
ReadWritePaths=%h/.local/state/telegram-reply-broker/callback-status.d
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
