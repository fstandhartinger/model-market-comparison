[Unit]
Description=Start the automatic native owner job for fast-lane order %i (INCIDENTS #25)

# Writes only ~/jobs/fastlane-native-<ref>/ from host-validated order facts, then hands the folder to
# ~/bin/job-start, which runs it as its own job-<name>.service. No customer code runs here.
[Service]
Type=oneshot
Environment=AGENT_BOARD_NAME=fastlane-autopickup
ExecStart=/usr/bin/python3 %h/bin/jevbench-autopickup.py native-owner %i
TimeoutStartSec=300
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/jobs
